<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="#EAF2FA"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Tab 1: Painel -->
    <LinearLayout
        android:id="@+id/navPainel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iconNavPainel"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_home"
            android:tint="@color/primary_blue"/>

        <TextView
            android:id="@+id/textNavPainel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Painel"
            android:textColor="@color/primary_blue"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tab 2: Montar Ficha -->
    <LinearLayout
        android:id="@+id/navMontarFicha"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iconNavMontarFicha"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_fitness"
            android:tint="@color/primary_blue"/>

        <TextView
            android:id="@+id/textNavMontarFicha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Montar Ficha"
            android:textColor="@color/primary_blue"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Tab 3: Alunos -->
    <LinearLayout
        android:id="@+id/navAlunos"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iconNavAlunos"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_profile"
            android:tint="@color/primary_blue"/>

        <TextView
            android:id="@+id/textNavAlunos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Alunos"
            android:textColor="@color/primary_blue"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Tab 4: Perfil -->
    <LinearLayout
        android:id="@+id/navPerfilInstrutor"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iconNavPerfilInstrutor"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_profile"
            android:tint="@color/primary_blue"/>

        <TextView
            android:id="@+id/textNavPerfilInstrutor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Perfil"
            android:textColor="@color/primary_blue"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>