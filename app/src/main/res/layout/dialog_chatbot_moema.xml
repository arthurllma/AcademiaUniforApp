<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootDialogContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="20dp"
    android:paddingTop="32dp"
    android:paddingBottom="32dp">

    <!-- Card Azul Principal do Chatbot -->
    <LinearLayout
        android:id="@+id/cardChatbot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_chatbot_dialog"
        android:clipToOutline="true"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header: Botão Fechar X -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btnFecharChat"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentStart="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Fechar"
                android:focusable="true"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/dark_navy" />
        </RelativeLayout>

        <!-- Lista de Mensagens do Chat -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChatMensagens"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            tools:listitem="@layout/item_chat_mensagem" />

        <!-- Barra de Digitação Inferior -->
        <LinearLayout
            android:id="@+id/containerInputBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_field"
            android:backgroundTint="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <EditText
                android:id="@+id/etChatInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="O que você gostaria de saber?"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:textColor="@color/dark_navy"
                android:textColorHint="@color/text_gray"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnEnviarChat"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_send_chat"
                android:clickable="true"
                android:contentDescription="Enviar"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_up"
                app:tint="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
